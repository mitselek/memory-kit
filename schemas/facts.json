{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeberg.org/mitselek/memory-kit/schemas/facts.json",
  "$comment": "GENERATED from caps.yaml by tools/gen-schemas.py. Do not hand-edit.",
  "title": "Facts file",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "facts"
  ],
  "properties": {
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact",
          "ref",
          "refute",
          "verified"
        ],
        "properties": {
          "fact": {
            "type": "string",
            "description": "One sentence, present tense, <= 42 words."
          },
          "ref": {
            "type": "string",
            "pattern": "^$|^[0-9a-f]{7,40}$|^[A-Za-z0-9._\\/-]+$|^#[0-9]+$|^urls\\/[a-z0-9-]+$|^po:S[0-9]+$|^[a-z][a-z0-9_-]*:[0-9]{4}-[0-9]{2}-[0-9]{2}$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Origin of the claim."
          },
          "refute": {
            "type": "string",
            "description": "Where to prove this WRONG: a command or a path. '=ref' when the origin doubles as the test. Blank = no test known; the lint counts it."
          },
          "verified": {
            "type": "string",
            "format": "date",
            "description": "Last date this SURVIVED a refutation attempt. Not a birthday."
          }
        }
      },
      "maxItems": 30
    }
  }
}
