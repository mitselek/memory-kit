{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeberg.org/mitselek/memory-kit/schemas/scratchpad.json",
  "$comment": "GENERATED from caps.yaml by tools/gen-schemas.py. Do not hand-edit.",
  "title": "Scratchpad",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "current",
    "staging"
  ],
  "properties": {
    "current": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "record",
          "ref"
        ],
        "properties": {
          "label": {
            "enum": [
              "DECISION",
              "LEARNED",
              "WARNING",
              "WIP",
              "DEFERRED",
              "PATTERN",
              "GOTCHA"
            ]
          },
          "record": {
            "type": "string",
            "maxLength": 100,
            "description": "One idea. Does not fit? It is two records. No URLs."
          },
          "ref": {
            "type": "string",
            "pattern": "^$|^[0-9a-f]{7,40}$|^[A-Za-z0-9._\\/-]+$|^#[0-9]+$|^urls\\/[a-z0-9-]+$|^po:S[0-9]+$|^[a-z][a-z0-9_-]*:[0-9]{4}-[0-9]{2}-[0-9]{2}$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Origin. Blank is counted, never failed."
          }
        }
      },
      "maxItems": 15,
      "description": "Act on these next session. Regenerated at close, never appended."
    },
    "staging": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "record",
          "ref"
        ],
        "properties": {
          "label": {
            "enum": [
              "DECISION",
              "LEARNED",
              "WARNING",
              "WIP",
              "DEFERRED",
              "PATTERN",
              "GOTCHA"
            ]
          },
          "record": {
            "type": "string",
            "maxLength": 100,
            "description": "One idea. Does not fit? It is two records. No URLs."
          },
          "ref": {
            "type": "string",
            "pattern": "^$|^[0-9a-f]{7,40}$|^[A-Za-z0-9._\\/-]+$|^#[0-9]+$|^urls\\/[a-z0-9-]+$|^po:S[0-9]+$|^[a-z][a-z0-9_-]*:[0-9]{4}-[0-9]{2}-[0-9]{2}$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Origin. Blank is counted, never failed."
          }
        }
      },
      "description": "Do not re-derive these. current + staging <= 100 (checked by the lint)."
    }
  }
}
